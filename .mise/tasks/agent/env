#!/usr/bin/env bash
#MISE description="Output environment variables for an agent"
#USAGE arg "[agent]" help="Agent name (defaults to GIT_AUTHOR_NAME)"
set -eo pipefail

AGENT="${usage_agent:-$GIT_AUTHOR_NAME}"

if [ -z "$AGENT" ]; then
  echo "Error: no agent specified and GIT_AUTHOR_NAME not set" >&2
  echo "Usage: oikos agent:env <agent>" >&2
  echo "   or: activate identity with shimmer as <agent> first" >&2
  exit 1
fi

# Validate agent exists in this home (best-effort — if agent:list fails,
# validation is skipped and any agent name is accepted)
AGENTS=$(mise run -q agent:list 2>/dev/null) || true
if [ -n "$AGENTS" ] && ! echo "$AGENTS" | grep -qx "$AGENT"; then
  echo "Error: unknown agent '$AGENT'" >&2
  exit 1
fi

# --- Environment variables this home wants set for its agents ---

DOMAIN="${OIKOS_EMAIL_DOMAIN:-oikos.local}"

# Chat identity — used by `chat read` to track per-agent read cursors
echo "export CHAT_IDENTITY='$AGENT'"

# Git and mail identity.
#
# This overrides `shimmer as <agent>`, which hardcodes @ricon.family
# (shimmer/.mise/tasks/as:87) — another household's domain, in a read-only
# package. Source this AFTER `shimmer as` so these values win.
echo "export GIT_AUTHOR_NAME='$AGENT'"
echo "export GIT_COMMITTER_NAME='$AGENT'"
echo "export GIT_AUTHOR_EMAIL='$AGENT@$DOMAIN'"
echo "export GIT_COMMITTER_EMAIL='$AGENT@$DOMAIN'"

# Secret provider.
#
# 1Password authorizes every `op` call individually through the desktop app,
# and the approval cannot be cached — it authorizes the calling process, and a
# shell pipeline is a new process each time. Reading a token per command means
# an authorization dialog per command.
#
# So prefer the local keyring when it can actually serve this agent. The probe
# is the switch: it only reports success when the agent's token is really
# cached, so a machine without the cache (or without the libsecret provider)
# silently keeps 1Password. See [[agent-credentials]] for how to populate it.
if secrets get "$AGENT/github-pat" --provider libsecret >/dev/null 2>&1; then
  echo "export SECRETS_PROVIDER='libsecret'"
fi
